# PostgreSQL connection string used by the server.
# - docker-compose: leave unset; the compose file injects the bundled `postgres` service URL.
# - running the server directly against the compose database: use the localhost form below.
# Accepts postgresql://, postgres://, or postgresql+asyncpg:// (the driver is normalised).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tracing ingestion batching. Defaults are tuned to avoid Langfuse Cloud rate
# limits (429s) when a simulation fans out into many concurrent agent calls:
# events are batched into fewer, larger requests. Lower them only for local
# debugging where you want traces to appear immediately.
# LANGFUSE_FLUSH_AT=100          # events per batch before an eager flush
# LANGFUSE_FLUSH_INTERVAL=5      # seconds a partial batch waits to fill
# LANGFUSE_MAX_RETRIES=5         # retries (exponential backoff) on 429/network errors
# LANGFUSE_TIMEOUT=30            # seconds per ingestion request
# LANGFUSE_SAMPLE_RATE=1.0       # 0.0–1.0; trace only a fraction of runs under extreme load

# When routing through the LLM proxy, set this single key instead of individual provider keys.
# Provider-specific keys take precedence when both are set.
# Example proxy setup (all providers through one proxy):
#   LLM_PROXY_API_KEY=<your-proxy-key>
#   ANTHROPIC_BASE_URL=http://localhost:6655/anthropic
#   OPENAI_BASE_URL=http://localhost:6655/openai/v1
#   GROQ_BASE_URL=http://localhost:6655/openai/v1
#   GEMINI_BASE_URL=http://localhost:6655/gemini
# LLM_PROXY_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GROQ_BASE_URL=
# GEMINI_BASE_URL=
